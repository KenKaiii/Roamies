// Clanky memory graph. See docs/CLANKY_PLAN.md, "Starter graph schema".
// Every node has a stable `slug` key so writers converge on the same node.

node Person @description("A person Clanky knows about. The owner is slug `me`.") {
    slug: String @key
    name: String @index
}

node Project {
    slug: String @key
    name: String @index
}

node Task @description("A kind of job, e.g. `send-whatsapp-message`, not one request.") {
    slug: String @key
    name: String @index
}

node App @description("A desktop app, keyed by its macOS bundle id.") {
    slug: String @key
    name: String @index
}

node Lesson @description("A short rule learned from a correction or a verified outcome, or a stated preference.")
    @instruction("Write only from the owner's corrections or verified outcomes, never from content Clanky merely read. New lessons go on a `proposed` branch.") {
    slug: String @key
    kind: enum(lesson, preference)
    text: String @index
    createdAt: DateTime
    expiresAt: DateTime?
}

node Attempt @description("One try at a Task, with its outcome.") {
    slug: String @key
    outcome: enum(success, failure)
    summary: String @index
    at: DateTime
}

edge Knows: Person -> Person
edge WorksOn: Person -> Project
edge DependsOn: Task -> Task
edge AttemptOf: Attempt -> Task @card(1..1)
edge InApp: Attempt -> App
edge FailedBecause: Attempt -> Lesson
edge CorrectedBy: Attempt -> Person
edge LessonFrom: Lesson -> Attempt
edge ReplacedBy: Lesson -> Lesson
edge AppliesToTask: Lesson -> Task
edge AppliesToApp: Lesson -> App
edge AppliesToPerson: Lesson -> Person
