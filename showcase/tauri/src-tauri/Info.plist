<plist version="1.0">
<dict>
  <!-- Menu bar only: no Dock icon, no app switcher entry, even during launch. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>Sidekick listens while you hold Control and Option.</string>
