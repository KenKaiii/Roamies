#!/usr/bin/env python3
"""Linux hands helper for Roamies: see one window or app, read its controls, work them.

Speaks the same command language as hands/main.swift and hands-win:
  windows | front | locate <target> | capture <out> <target> [max] [thumb thumbMax]
  ui <target> [controls] | locate-control <target> <id> | find-text <target> <text> [scroll]
  ocr-find <target> <text> [all] | refine '[[x,y,w,h],...]' [window:<id>]
  act <json> | tab <json> | wm <json> | pointer <json> | select <out>
  trusted | guide | screencheck | selftest-type | selftest-drag | selftest-safety
One JSON object on stdout; live progress lines start with "@" on stderr.

Windows come from Hyprland. Controls and text come from AT-SPI, with OCR of the window
screenshot as a fallback. Clicks, keys and scrolling go through ydotool; typing uses
ydotool for ASCII and wtype for anything else.
"""

import fcntl
import glob
import json
import os
import re
import struct
import shutil
import subprocess
import sys
import tempfile
import time

try:
    import lz4.block
except Exception:
    lz4 = None

# ---------------------------------------------------------------- helpers


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def sh_out(cmd):
    r = sh(cmd)
    return r.stdout if r.returncode == 0 else ""


def hypr(kind):
    try:
        return json.loads(sh_out(["hyprctl", kind, "-j"]) or "{}")
    except Exception:
        return {}


def monitors():
    return hypr("monitors") or []


def clients():
    return [c for c in (hypr("clients") or []) if c.get("mapped", True)]


def is_roamies(app, title=""):
    a = (app or "").lower()
    return a in ("roamies", "roamies-overlay") or (title or "").lower().startswith("roamies")


def exe_for(pid):
    try:
        return os.readlink(f"/proc/{pid}/exe")
    except Exception:
        return ""


def scale_for(bounds):
    x, y, w, h = bounds
    cx, cy = x + w / 2, y + h / 2
    for m in monitors():
        mx, my = m.get("x", 0), m.get("y", 0)
        mw, mh = m.get("width", 0), m.get("height", 0)
        if mx <= cx <= mx + mw and my <= cy <= my + mh:
            return float(m.get("scale", 1) or 1)
    return 1.0


ZEN_CACHE = {"key": None, "data": None}


def is_zen(win):
    """Zen, and only Zen: "zenity" also starts with zen, but has no session store."""
    app = (win.get("app") or "").strip().lower()
    exe = (win.get("exe") or "").strip().lower()
    return app in ("zen", "zen browser") or "zen-bin" in exe or "zen-browser" in exe or "/zen/" in exe


def norm_uuid(u):
    return str(u or "").strip("{}").lower()


def zen_recovery():
    # ROAMIES_ZEN_PROFILE points at a test profile, so testing never reads or acts on the live browser's store.
    env = os.environ.get("ROAMIES_ZEN_PROFILE")
    if env:
        p = os.path.join(os.path.expanduser(env), "sessionstore-backups", "recovery.jsonlz4")
        if os.path.exists(p):
            return p
    files = glob.glob(os.path.expanduser("~/.config/zen/*/sessionstore-backups/recovery.jsonlz4"))
    files = [f for f in files if os.path.exists(f)]
    return max(files, key=os.path.getmtime) if files else None


def zen_pref_active(path):
    try:
        text = open(os.path.join(os.path.dirname(os.path.dirname(path)), "prefs.js"), encoding="utf-8", errors="ignore").read()
        m = re.search(r'user_pref\(\s*"zen\.workspaces\.active"\s*,\s*"([^"]+)"', text)
        return norm_uuid(m.group(1)) if m else None
    except Exception:
        return None


def zen_state():
    """The active Zen workspace and each workspace's tabs, from the session store.

    Zen keeps this in sessionstore-backups/recovery.jsonlz4 (mozLz4 JSON): windows[].spaces
    holds the workspace records, activeZenSpace is the selected one, and every tab carries
    zenWorkspace. prefs.js (zen.workspaces.active) is only a hint, since it flushes late.
    """
    if lz4 is None:
        return None
    path = zen_recovery()
    if not path:
        return None
    try:
        key = (path, os.path.getmtime(path), os.path.getsize(path))
    except Exception:
        key = (path, 0, 0)
    if ZEN_CACHE["key"] == key:
        return ZEN_CACHE["data"]
    try:
        data = open(path, "rb").read()
        if data[:8] != b"mozLz40\0":
            return None
        size = int.from_bytes(data[8:12], "little")
        doc = json.loads(lz4.block.decompress(data[12:], uncompressed_size=size))
    except Exception:
        return None
    wins = doc.get("windows") or []
    win = next((w for w in wins if w.get("spaces") or w.get("activeZenSpace")), wins[0] if wins else None)
    if not win:
        return None
    spaces, order = {}, []
    for sp in win.get("spaces") or []:
        u = norm_uuid(sp.get("uuid"))
        spaces[u] = {"uuid": u, "name": sp.get("name") or "Untitled", "active": False, "tabs": []}
        order.append(u)
    active = norm_uuid(win.get("activeZenSpace")) or zen_pref_active(path)
    if active in spaces:
        spaces[active]["active"] = True
    try:
        selected = int(win.get("selected") or 0)
    except Exception:
        selected = 0
    for pos, tab in enumerate(win.get("tabs") or [], 1):
        u = norm_uuid(tab.get("zenWorkspace"))
        if u not in spaces:
            u = "essentials" if tab.get("zenEssential") else "other"
            if u not in spaces:
                spaces[u] = {"uuid": u, "name": "Essentials" if u == "essentials" else "Unassigned", "active": False, "tabs": []}
                order.append(u)
        entry = (tab.get("entries") or [{}])[-1]
        title = entry.get("title") or entry.get("url") or tab.get("userTypedValue") or ""
        spaces[u]["tabs"].append({
            "title": str(title)[:120],
            "url": str(entry.get("url") or "")[:200],
            "pinned": bool(tab.get("pinned")),
            "essential": bool(tab.get("zenEssential")),
            "current": bool(selected and pos == selected),
        })
    res = {"active": spaces[active]["name"] if active in spaces else None, "selected": selected, "spaces": [spaces[u] for u in order], "source": path}
    ZEN_CACHE["key"], ZEN_CACHE["data"] = key, res
    return res

ZEN_SUFFIX = re.compile(r"\s+[\u2014\u2013-]\s+Zen Browser\s*$")


def norm_title(t):
    return " ".join(str(t or "").split()).lower()


def norm_url(u):
    u = re.sub(r"#.*$", "", str(u or "").strip())
    return u.rstrip("/").lower()


def url_host(u):
    m = re.match(r"^[a-z][a-z0-9+.-]*://([^/]+)", str(u or ""), re.I)
    return m.group(1).lower() if m else ""


def title_words(t):
    return [w for w in re.split(r"[^0-9a-z]+", norm_title(t)) if len(w) > 1]


def title_match(a, b):
    """Whether a stored tab title still describes the live one: Zen's saved titles drift (a page adds its site
    name, or drops a leading section such as "Home ―"), or a redirect changes it. Compare the main section too."""
    na, nb = norm_title(a), norm_title(b)
    if not na or not nb:
        return False
    if na == nb:
        return True
    if na in nb or nb in na:
        return min(len(na), len(nb)) >= 6
    def core(t):
        parts = [x.strip() for x in re.split(r"\s+[\|\u2014\u2013-]\s+", norm_title(t)) if x.strip()]
        return max(parts, key=len) if parts else ""
    ca, cb = core(a), core(b)
    if ca and cb and (ca == cb or ca in cb or cb in ca) and min(len(ca), len(cb)) >= 5:
        return True
    wa, wb = set(title_words(a)), set(title_words(b))
    if not wa or not wb:
        return False
    return len(wa & wb) / min(len(wa), len(wb)) >= 0.7


def url_close(a, b):
    """Same page even if the query or fragment changed: same scheme, host and path."""
    def clean(u):
        u = re.sub(r"[?#].*$", "", str(u or "").strip()).rstrip("/").lower()
        return u
    ca, cb = clean(a), clean(b)
    return bool(ca) and ca == cb


def active_title(win):
    """This window's title, if it is the focused window (after acting, to read back what changed)."""
    a = hypr("activewindow") or {}
    if str(a.get("address", "")).lower() != str(win.get("id", "")).lower():
        return None
    return str(a.get("title") or "").strip()


def zen_active_title(win):
    """The title of the selected tab in this Zen window, or None if Zen isn't the focused window."""
    t = active_title(win)
    return ZEN_SUFFIX.sub("", t).strip() if t is not None else None


def clip_text():
    if not shutil.which("wl-paste"):
        return None
    try:
        r = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=2)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def copy_active_url(win):
    """The selected tab's address, read through the browser: Ctrl+L selects the address, Ctrl+C copies it.
    An unchanged clipboard means the copy didn't take (a new tab with no address), not that the old URL is
    still the page, so that reads as unknown."""
    prev = clip_text()
    press_combo("ctrl+l")
    time.sleep(0.25)
    press_combo("ctrl+c")
    time.sleep(0.18)
    press_combo("escape")
    time.sleep(0.12)
    u = (clip_text() or "").strip()
    # Put back whatever they had on the clipboard before the copy.
    if prev is not None and shutil.which("wl-copy"):
        sh(["wl-copy", "--", prev])
    if u and u == prev:
        return ""
    return u


def zen_tab_controls(z, active_title=None):
    """One control per tab: its workspace, title (label) and address (value), so a tab can be picked by id."""
    out = []
    at = norm_title(active_title)
    for sp in z.get("spaces") or []:
        for n, t in enumerate(sp.get("tabs") or [], 1):
            c = {
                "role": "tab",
                "label": f"{sp['name']} \u00b7 {t.get('title') or '(untitled)'}"[:120],
                "value": str(t.get("url") or "")[:300],
                "workspace": sp["name"],
                "title": t.get("title") or "",
                "url": t.get("url") or "",
                "num": n,
                "current": bool(title_match(t.get("title"), active_title)) if at else bool(t.get("current")),
            }
            out.append(c)
    return out


def zen_find_space(z, name):
    if not name:
        return None
    q = str(name).strip().lower()
    for sp in z.get("spaces") or []:
        if sp["name"].lower() == q or sp["uuid"].startswith(q) or q in sp["name"].lower():
            return sp
    return None


def zen_pick(z, workspace=None, index=None, text=None, url=None):
    spaces = list(z.get("spaces") or [])
    if workspace:
        wl = workspace.strip().lower()
        spaces = [sp for sp in spaces if sp["name"].lower() == wl or sp["uuid"].startswith(wl) or wl in sp["name"].lower()]
        if not spaces:
            names = ", ".join(sp["name"] for sp in z.get("spaces") or [])
            fail(f"There's no Zen workspace called {workspace}. The workspaces are: {names}.")
    if workspace and index is None and not text and not url:
        sp = spaces[0]
        tabs = sp.get("tabs") or []
        if not tabs:
            fail(f"{sp['name']} has no tabs to show.")
        return sp, next((t for t in tabs if t.get("current")), tabs[0])
    if index is not None:
        sp = next((x for x in spaces if x.get("active")), spaces[0] if len(spaces) == 1 else None)
        if sp is None:
            names = ", ".join(x["name"] for x in spaces)
            fail(f"Say which workspace the tab number is in ({names}).")
        try:
            i = int(index) - 1
        except Exception:
            fail("The tab number must be a whole number.")
        if not (0 <= i < len(sp.get("tabs") or [])):
            fail(f"{sp['name']} has {len(sp.get('tabs') or [])} tabs, so #{index} is out of range.")
        return sp, sp["tabs"][i]
    matches = []
    q = str(text or "").strip().lower()
    qhost = re.sub(r"^[a-z][a-z0-9+.-]*://", "", q).split("/")[0] if q else ""
    if qhost in ("http:", "https:"):
        qhost = ""
    for sp in spaces:
        for t in sp.get("tabs") or []:
            if url and norm_url(t.get("url")) == norm_url(url):
                matches.append((sp, t))
            elif text and (q in (t.get("title") or "").lower() or q in (t.get("url") or "") or title_match(t.get("title"), text)
                           or (qhost and "." in qhost and url_host(t.get("url")) == qhost)):
                matches.append((sp, t))
    if not matches:
        what = text or url
        fail(f"No Zen tab matches {what!r}. Read the window again to see the tabs.")
    matches.sort(key=lambda m: (m[0].get("active") is not True, not title_match(m[1].get("title"), text or ""), ) if text else (m[0].get("active") is not True,))
    return matches[0]


def zen_locate_current(z, win):
    """Which workspace the selected tab is in, read from the browser itself (its address, then its title)."""
    u = copy_active_url(win)
    title = zen_active_title(win)
    nu = norm_url(u)
    if nu and nu != "about:blank":
        hit = [sp for sp in z.get("spaces") or [] if any(norm_url(t.get("url")) == nu for t in sp.get("tabs") or [])]
        if len(hit) == 1:
            return hit[0]
    if title:
        hit = [sp for sp in z.get("spaces") or [] if any(norm_title(t.get("title")) == norm_title(title) for t in sp.get("tabs") or [])]
        if len(hit) == 1:
            return hit[0]
    return None


def zen_current_space(z, win):
    """The workspace showing now: the selected tab's address or title, else the pref hint Zen flushes (which is
    often newer than the session store), else the store's idea."""
    cur = zen_locate_current(z, win)
    if cur:
        return cur
    hint = zen_pref_active(z.get("source") or zen_recovery() or "")
    if hint:
        for sp in z.get("spaces") or []:
            if sp["uuid"] == hint:
                return sp
    return next((sp for sp in z.get("spaces") or [] if sp.get("active")), None)


def zen_switch_space(z, win, target):
    cur = zen_current_space(z, win)
    if cur and cur["uuid"] == target["uuid"]:
        return True
    order = [sp["uuid"] for sp in z.get("spaces") or []]
    if not cur or cur["uuid"] not in order or target["uuid"] not in order:
        return False
    steps = (order.index(target["uuid"]) - order.index(cur["uuid"])) % len(order)
    left = (len(order) - steps) % len(order)
    key = "right" if steps <= left else "left"
    for _ in range(min(steps, left)):
        press_combo(f"ctrl+alt+{key}")
        time.sleep(0.35)
    # The steps are deterministic from a known space. Check the selected tab's title against the target's tabs;
    # if that can't tell (a new tab), the address; either way do not wander through every workspace on a maybe.
    t = zen_active_title(win) or ""
    if t and any(title_match(tab.get("title"), t) for tab in target.get("tabs") or []):
        return True
    now = zen_locate_current(z, win)
    if now and now["uuid"] == target["uuid"]:
        return True
    return True


def zen_switch_space_from(z, win, current, target):
    """Switch by the spaces' sidebar order, from a known space. Used after opening a tab the store doesn't
    know yet, when the selected tab's address can't be found in the store."""
    order = [sp["uuid"] for sp in z.get("spaces") or []]
    if current.get("uuid") not in order or target.get("uuid") not in order:
        return False
    steps = (order.index(target["uuid"]) - order.index(current["uuid"])) % len(order)
    left = (len(order) - steps) % len(order)
    key = "right" if steps <= left else "left"
    for _ in range(min(steps, left)):
        press_combo(f"ctrl+alt+{key}")
        time.sleep(0.35)
    return True


def zen_tab_report(space, tab, url, switched, live_title=None):
    where = f" in {space['name']}" if space.get("uuid") != "essentials" else " (an essential tab)"
    title = live_title or tab.get("title") or "(untitled)"
    what = f"switched to tab \"{title}\"{where}" if switched else f"tab \"{title}\" was already active{where}"
    return f"{what} ({url or tab.get('url') or 'no address'})"


def zen_activate_tab(win, workspace=None, index=None, text=None, url=None):
    """Switch to a Zen tab through the browser, never by clicking the sidebar: pick the workspace, then cycle
    tabs with Ctrl+Tab until the selected tab's own title and address are the ones asked for."""
    z = zen_state()
    if not z:
        fail("Zen's session store couldn't be read, so its tabs aren't known. Is Zen open?")
    space, tab = zen_pick(z, workspace, index, text, url)
    want_t, want_u = tab.get("title") or "", tab.get("url") or ""
    if space.get("uuid") != "essentials" and not zen_switch_space(z, win, space):
        fail(f"Couldn't switch Zen to the {space['name']} workspace (it may have no tabs, or the browser kept focus). Ask the user to click the workspace once, then try again.")
    cur_t = zen_active_title(win)
    if cur_t is None:
        fail("Zen isn't the focused window, so the tab can't be checked. Ask the user to click it, then try again.")
    cur_u = copy_active_url(win)
    if title_match(cur_t, want_t) and (not want_u or norm_url(cur_u) == norm_url(want_u) or url_close(cur_u, want_u)):
        return zen_tab_report(space, tab, cur_u, False, cur_t)
    total = max(len(space.get("tabs") or []), 1) + 6
    for _ in range(total):
        if not press_combo("ctrl+tab"):
            fail("Couldn't press Ctrl+Tab.")
        time.sleep(0.22)
        cur_t = zen_active_title(win)
        if cur_t is None:
            fail("Zen lost focus while switching tabs. Ask the user to click its window, then try again.")
        if title_match(cur_t, want_t):
            cur_u = copy_active_url(win)
            if not want_u or norm_url(cur_u) == norm_url(want_u) or url_close(cur_u, want_u):
                return zen_tab_report(space, tab, cur_u, True, cur_t)
    fail(f"Couldn't reach the tab \"{want_t}\" in {space['name']} (cycled {total - 6} tabs). Read the window again to see its tabs.")


def zen_open_tab(win, url, workspace=None):
    """Open a web address as a new tab in a chosen workspace, then check the tab reached it."""
    u = str(url or "").strip()
    if not u:
        fail("Give a web address to open.")
    if not re.match(r"^[a-z][a-z0-9+.-]*://", u, re.I):
        u = "https://" + u.lstrip("/")
    if not re.match(r"^https?://[^\s]+$", u, re.I):
        fail(f"{url!r} isn't a web address (http or https).")
    z = zen_state()
    space = None
    if workspace:
        space = zen_find_space(z, workspace) if z else None
        if not space:
            fail(f"There's no Zen workspace called {workspace}.")
        if space.get("uuid") != "essentials" and not zen_switch_space(z, win, space):
            fail(f"Couldn't switch Zen to the {space['name']} workspace.")
    host = url_host(u)
    press_combo("ctrl+t")
    time.sleep(0.45)
    press_combo("ctrl+l")
    time.sleep(0.2)
    if not type_text(u):
        fail("Couldn't type the address.")
    time.sleep(0.1)
    press_combo("return")
    cur, title = "", ""
    for _ in range(24):
        time.sleep(0.35)
        cur = copy_active_url(win)
        title = zen_active_title(win) or ""
        if cur and (norm_url(cur) == norm_url(u) or (host and host == url_host(cur))):
            where = space["name"] if space else ((z or {}).get("active") or "the current workspace")
            return f"opened tab \"{title}\" ({cur}) in {where}"
    fail(f"The tab opened but never reached {u} (now \"{title}\" — {cur or 'no address'}).")


def zen_close_tab(win, workspace=None, index=None, text=None, url=None):
    """Close one tab, by switching to it through the browser first (never by clicking the sidebar)."""
    z = zen_state()
    if not z:
        fail("Zen's session store couldn't be read, so its tabs aren't known.")
    # A tab opened this second may not be in the store yet: if the tab showing now is the one asked for, close it.
    if not workspace and index is None:
        cur_u = copy_active_url(win)
        cur_t = zen_active_title(win) or ""
        direct = (url and norm_url(cur_u) == norm_url(url)) or (not url and text and (str(text).lower() in cur_t.lower() or title_match(cur_t, text)))
        active_space = next((sp for sp in z.get("spaces") or [] if sp.get("active")), None)
        if direct:
            if active_space and len(active_space.get("tabs") or []) <= 1:
                fail(f"\"{cur_t}\" looks like the only tab in {active_space['name']}; closing it would close the window.")
            time.sleep(0.2)
            press_combo("ctrl+w")
            time.sleep(0.6)
            now_t = zen_active_title(win) or ""
            now_u = copy_active_url(win)
            return f"closed tab \"{cur_t}\" ({cur_u}); now showing \"{now_t}\" ({now_u or 'no address'})"
    space, tab = zen_pick(z, workspace, index, text, url)
    if len(space.get("tabs") or []) <= 1:
        fail(f"\"{tab.get('title')}\" is the only tab in {space['name']}; closing it would close the window.")
    zen_activate_tab(win, space["name"], None, tab.get("title"), tab.get("url"))
    time.sleep(0.2)
    press_combo("ctrl+w")
    time.sleep(0.6)
    cur_t = zen_active_title(win) or ""
    cur_u = copy_active_url(win)
    return f"closed tab \"{tab.get('title')}\" ({tab.get('url')}); now showing \"{cur_t}\" ({cur_u or 'no address'})"


def zen_move_tab(win, workspace, to, index=None, text=None, url=None):
    """Move a tab to another workspace by reopening it there through the browser, then closing the original.
    Zen's tab context menu is chrome-only, so there is no pointer-free in-place move."""
    z = zen_state()
    if not z:
        fail("Zen's session store couldn't be read, so its tabs aren't known.")
    cur_u = copy_active_url(win)
    cur_t = zen_active_title(win) or ""
    try:
        src, tab = zen_pick(z, workspace, index, text, url)
    except SystemExit:
        # Opened moments ago, so not in the store yet: the tab showing now is the one.
        match = (url and norm_url(cur_u) == norm_url(url)) or (not url and text and title_match(cur_t, text))
        src = zen_find_space(z, workspace) if workspace else next((sp for sp in z.get("spaces") or [] if sp.get("active")), None)
        if not match or not src:
            raise
        tab = {"title": cur_t, "url": cur_u}
    dst = zen_find_space(z, to)
    if not dst:
        fail(f"There's no Zen workspace called {to}.")
    if src.get("uuid") == dst.get("uuid"):
        return f"\"{tab.get('title')}\" is already in {src['name']}."
    if len(src.get("tabs") or []) <= 1:
        fail(f"\"{tab.get('title')}\" is the only tab in {src['name']}; moving it would close the window.")
    zen_activate_tab(win, src["name"], None, tab.get("title"), tab.get("url"))
    u = copy_active_url(win) or tab.get("url") or ""
    opened = zen_open_tab(win, u, dst["name"])
    z2 = zen_state() or z
    src2 = zen_find_space(z2, src["name"]) or src
    dst2 = zen_find_space(z2, dst["name"]) or dst
    if not zen_switch_space_from(z2, win, dst2, src2) and not zen_switch_space(z2, win, src2):
        return f"{opened}, but couldn't switch back to {src['name']} to close the original; close it there."
    # The source tab may be the one still showing (a just-opened tab isn't in the store), or a stored one.
    if norm_url(copy_active_url(win)) != norm_url(tab.get("url") or u):
        zen_activate_tab(win, src2["name"], None, tab.get("title"), tab.get("url") or u)
    time.sleep(0.2)
    press_combo("ctrl+w")
    time.sleep(0.6)
    cur_t = zen_active_title(win) or ""
    return f"moved \"{tab.get('title')}\" from {src['name']} to {dst['name']} (reopened as {u}; {src['name']} now shows \"{cur_t}\")"


