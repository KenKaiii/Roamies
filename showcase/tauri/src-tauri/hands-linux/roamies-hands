def match_kind(text, q):
    t, ql = text.strip().lower(), q.strip().lower()
    if t == ql:
        return "whole"
    if ql in t:
        return "part"
    return "words" if all(w in t.split() for w in ql.split()) else None


def cmd_find_text(target, q, scroll=False):
    wins = []
    if target == "screen":
        wins = visible_clients()
    elif target == "front":
        f = front_client()
        wins = [c for c in visible_clients() if f and c.get("pid") == f.get("pid")]
    elif target.startswith("app:"):
        name = target[4:].lower()
        wins = [c for c in visible_clients() if name in ((c.get("class") or "") + (c.get("title") or "")).lower()]
    else:
        w = resolve(target)
        wins = [w] if w else []
    if not wins:
        fail("No matching window is open.")
    matches = []
    for rank, w in enumerate(wins[:12]):
        for c in controls_of(w):
            kind = match_kind(str(c.get("label", "")), q)
            if not kind:
                continue
            matches.append({"text": c.get("label", "")[:80], "match": kind, "role": c.get("role"), "bounds": c.get("bounds"), "window": w, "rank": rank})
    exact = [m for m in matches if m["match"] == "whole"]
    rest = [m for m in matches if m["match"] != "whole"]
    out({"ok": True, "matches": (exact + rest)[:8]})


