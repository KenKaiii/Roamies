def press_combo(combo):
    parts = [p.strip().lower() for p in re.split(r"[+\-]", combo) if p.strip()]
    codes = [KEY[p] for p in parts if p in KEY]
    if not codes:
        return False
    seq = []
    for c in codes:
        seq.append(f"{c}:1")
    for c in reversed(codes):
        seq.append(f"{c}:0")
    ydotool("key", *seq)
    return True


def type_text(text, xwayland=False):
    if not text:
        return True
    # wtype sends Wayland keys; XWayland apps decode them with the wrong keymap (letters became digits and
    # symbols, and it still returned success), so XWayland gets ydotool's uinput keyboard. Wayland does the
    # opposite: wtype is exact there. Clipboard paste is the exact fallback for both.
    def via_wtype():
        return bool(shutil.which("wtype")) and sh(["wtype", "--", text]).returncode == 0

    def via_ydotool():
        if not all(ord(ch) < 128 for ch in text):
            return False
        return ydotool("type", "--key-delay", "2", "--", text).returncode == 0

    def via_clipboard():
        if not shutil.which("wl-copy"):
            return False
        prev = clip_text()
        sh(["wl-copy", "--", text])
        press_combo("ctrl+v")
        time.sleep(0.2)
        # Typing must not leave the user's clipboard holding what was typed.
        if prev is not None:
            sh(["wl-copy", "--", prev])
        return True

    order = [via_ydotool, via_clipboard, via_wtype] if xwayland else [via_wtype, via_clipboard, via_ydotool]
    for attempt in order:
        if attempt():
            return True
    return False


def click_at(x, y, button=1):
    cursor_move(x, y)
    time.sleep(0.06)
    # ydotool names buttons in hex and 0x01 is the *right* one; 1 from a tool means the left button.
    code = {1: "0xC0", 2: "0xC1", 3: "0xC2"}.get(int(button or 1), "0xC0")
    ydotool("click", code)


def controls_of(win):
    return ui_data(win, controls_only=True)


def find_control(win, text=None, cid=None, field=False):
    controls = controls_of(win)
    if cid is not None:
        try:
            i = int(cid) - 1
            if 0 <= i < len(controls):
                return controls[i]
        except Exception:
            pass
        return None
    if text is None:
        return None
    q = text.strip().lower()
    candidates = []
    for c in controls:
        label = str(c.get("label", "")).strip().lower()
        value = str(c.get("value", "")).strip().lower()
        if not label and not value:
            continue
        if field and c.get("role") != "text field" and c.get("role") != "text":
            continue
        score = 3 if label == q else 2 if label.startswith(q) else 1 if q in label or q in value else 0
        if score:
            candidates.append((score, c))
    if not candidates:
        # A browser's accessibility tree can be partial: retry the words against OCR of its window.
        try:
            ocr = ocr_ui(win)["controls"]
        except Exception:
            ocr = []
        for c in ocr:
            label = str(c.get("label", "")).strip().lower()
            if label == q:
                return c
        for c in ocr:
            label = str(c.get("label", "")).strip().lower()
            if q in label:
                return c
        return None
    candidates.sort(key=lambda t: (-t[0], 1 if t[1].get("offscreen") else 0))
    return candidates[0][1]


def center(bounds):
    x, y, w, h = bounds
    return x + w / 2, y + h / 2


def focus_window(win):
    addr = win.get("id")
    if not addr:
        return False
    sh(["hyprctl", "dispatch", f"hl.dsp.focus({{ window = 'address:{addr}' }})"])
    time.sleep(0.35)
    active = hypr("activewindow") or {}
    return str(active.get("address", "")).lower() == str(addr).lower()


def norm_text(data):
    parts = []
    for t in data.get("texts") or []:
        parts.append(str(t))
    for c in data.get("controls") or []:
        parts.append(str(c.get("label") or ""))
        parts.append(str(c.get("value") or ""))
    return " ".join(" ".join(parts).split()).lower()


def permission_dialog():
    for c in visible_clients():
        s = ((c.get("class") or "") + " " + (c.get("title") or "")).lower()
        if "xdg-desktop-portal" in s or ("allow" in s and any(x in s for x in ("screen", "share", "record"))):
            return win_info(c)
    return None


def permission_prompt_in(png):
    """A browser's own Allow/Deny screen-capture prompt, read from the picture: in-page, so no window to find."""
    try:
        words = tsv_words(png, (0, 0), 1.0)
    except Exception:
        return False
    hits = {w["text"].strip().lower().strip(".,:;!?()[]"): w["bounds"] for w in words}
    if "allow" not in hits or "deny" not in hits:
        return False
    near = abs(hits["allow"][1] - hits["deny"][1]) < 220 and abs(hits["allow"][0] - hits["deny"][0]) < 700
    shared = any(k in hits for k in ("screen", "share", "sharing", "record", "capture", "display"))
    return bool(near and shared)


def step_bounds(bounds, do):
    progress({"ev": "step", "do": do, "bounds": bounds})


