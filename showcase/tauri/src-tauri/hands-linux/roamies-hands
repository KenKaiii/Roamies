def cmd_selftest_type():
    """Type the same long string into a Wayland terminal and an XWayland terminal, then compare the files."""
    results = []
    work = tempfile.mkdtemp(prefix="roamies-type-")  # private to this user, unlike a fixed name in /tmp
    for label, x11 in (("wayland", False), ("xwayland", True)):
        title = "TypeSelf" + label
        target = os.path.join(work, f"{label}.txt")
        args = ["kitty", "--title", title, "sh", "-c", 'cat > "$0"', target]
        if x11:
            args = ["env", "-u", "WAYLAND_DISPLAY"] + args
        subprocess.Popen(["setsid"] + args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2.5)
        w = None
        for c in visible_clients():
            if title in (c.get("title") or ""):
                w = win_info(c)
                break
        if not w:
            results.append({"where": label, "ok": False, "error": "the test window didn't open"})
            continue
        if not focus_window(w):
            results.append({"where": label, "ok": False, "error": "couldn't focus the test window"})
            continue
        type_text(TYPE_TEST_TEXT, x11)
        time.sleep(0.4)
