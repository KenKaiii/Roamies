# Only cosmetic options can be set from here; anything that can add binds or run commands stays in the settings app.
OPTION_WRITES = {
    "general:gaps_in": "int", "general:gaps_out": "int", "general:border_size": "int",
    "decoration:rounding": "int", "decoration:active_opacity": "float", "decoration:inactive_opacity": "float",
    "decoration:dim_inactive": "bool", "animations:enabled": "bool", "misc:disable_hyprland_logo": "bool",
    "misc:disable_splash_rendering": "bool", "cursor:inactive_timeout": "int",
}


def desktop_entries():
    for d in LAUNCH_DIRS:
        for path in glob.glob(os.path.join(d, "*.desktop")):
            try:
                text = open(path, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            if re.search(r"^NoDisplay\s*=\s*true\s*$", text, re.I | re.M):
                continue
            name = re.search(r"^Name\s*=\s*(.+)$", text, re.M)
            if name:
                yield (os.path.basename(path)[:-8], name.group(1).strip(), path)


def open_app(name):
    """Open a web address, a file or a desktop app without a shell, so this cannot run arbitrary commands."""
    n = str(name or "").strip()
    if not n or "\n" in n or "\r" in n or "\0" in n:
        fail("Invalid app or address")
    if n.startswith(("http://", "https://", "mailto:")):
        subprocess.Popen(["xdg-open", n], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return f"Opened {n}"
    path = os.path.expanduser(n)
    if os.path.exists(path):
        subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return f"Opened {n}"
    if re.search(r"[;&|`$<>]", n):
        fail("That is a command, not an app. Ask the user to run it, or use run_command.")
    low = n.lower()
    entries = list(desktop_entries())
    hit = next((e for e in entries if e[0].lower() == low or e[1].lower() == low), None)
    if not hit:
        hit = next((e for e in entries if low in e[1].lower()), None)
    if not hit:
        fail(f"There's no app called {n!r}.")
    if shutil.which("gio"):
        subprocess.Popen(["gio", "launch", hit[2]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif shutil.which("gtk-launch"):
        subprocess.Popen(["gtk-launch", hit[0]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        fail("This computer has neither gio nor gtk-launch to open apps.")
    return f"Opened {hit[1]}"


