def safe_name(value, what):
    """Workspace, monitor and special names go into a Hyprland expression: keep them to plain characters."""
    v = str(value or "").strip()
    if not SAFE_NAME.match(v):
        fail(f"Invalid {what}: {v[:40]!r}")
    return v


def resolve(target):
    if not target or target == "screen":
        return None
    # The sidecar prefixes app: to a read target; tolerate app:window:..., app:front, app:0x...
    while target.startswith("app:") and target[4:].startswith(("window:", "app:", "screen", "front", "0x")):
        target = target[4:]
    if target.startswith("0x"):
        target = "window:" + target
    fp = front_client()
    fp = fp.get("pid") if fp else None
    if target == "front":
        c = front_client()
        return win_info(c, c.get("pid")) if c else None
    if target.startswith("window:"):
        want = target[7:]
        for c in clients():
            if str(c.get("address", "")).lower() == want.lower():
                return win_info(c, fp)
        return None
    if target.startswith("app:"):
        target = target[4:]
    name = target.lower()
    for c in visible_clients():
        app = (c.get("class") or c.get("initialClass") or "").lower()
        title = (c.get("title") or "").lower()
        if app == name or name in app or name in title:
            return win_info(c, fp)
    return None


