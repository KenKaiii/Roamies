def browser_url(win):
    app = atspi_app(win.get("pid", 0), (win.get("app") or "").lower())
    if app is None:
        return None
    found = []

    def walk_url(acc, depth=0):
        if depth > 24 or found:
            return
        try:
            name = (acc.get_name() or "").lower()
            role = (acc.get_role_name() or "").lower()
            if role in ("entry", "text") and ("address" in name or "url" in name or "search" in name):
                t = acc_text(acc).strip()
                if t.startswith("http"):
                    found.append(t)
            for i in range(acc.get_child_count()):
                walk_url(acc.get_child_at_index(i), depth + 1)
        except Exception:
            return

    walk_url(app)
    return found[0] if found else None


