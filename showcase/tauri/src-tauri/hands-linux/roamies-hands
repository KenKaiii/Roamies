    d = permission_dialog()
    if d:
        fail("A screen-capture permission dialog is open (Allow/Deny). Ask the user to allow it; don't click it.")
    if target == "screen":
        ms = monitors()
        bounds = [ms[0].get("x", 0), ms[0].get("y", 0), ms[0].get("width", 0), ms[0].get("height", 0)] if ms else None
        png = capture_png(screen=True, cursor=True)
        o = {"ok": True, "file": file, "what": "screen"}
    else:
        w = resolve(target)
        if not w:
            fail(no_window(target)["error"])
        bounds = w["bounds"]
        png = capture_png(w, cursor=True)
        o = {"ok": True, "file": file, "window": w}
    if not png:
        fail("Screen capture failed.")
    try:
        if permission_prompt_in(png):
            fail("A screen-capture permission prompt is in the picture (Allow / Deny). Tell the user to allow it; don't click it.")
        args = ["convert", png]
        if maxw:
            args += ["-resize", f"{maxw}x>"]
        if file.lower().endswith((".jpg", ".jpeg")):
            args += ["-quality", "85"]
        args += [file]
        r = sh(args)
        if r.returncode != 0:
            shutil.copyfile(png, file)
        if bounds:
            o["bounds"] = bounds
        try:
            dims = sh_out(["identify", "-format", "%w %h", file]).split()
            if len(dims) == 2:
                o["pixels"] = [int(dims[0]), int(dims[1])]
        except Exception:
            pass
        if thumb:
            args = ["convert", png, "-resize", f"{thumb_max}x>", "-quality", "72", thumb]
            sh(args)
    finally:
        try:
            os.unlink(png)
        except Exception:
            pass
    out(o)


