def atspi_app(pid, win_name=""):
    if Atspi is None:
        return None
    try:
        desktop = Atspi.get_desktop(0)
    except Exception:
        return None
    name_wanted = win_name or ""
    for i in range(desktop.get_child_count()):
        try:
            app = desktop.get_child_at_index(i)
            if pid and app.get_process_id() == pid:
                return app
            if name_wanted and name_wanted in (app.get_name() or "").lower():
                return app
        except Exception:
            continue
    return None


def acc_text(acc):
    try:
        t = acc.get_text(0, -1)
        return t or ""
    except Exception:
        return ""


def walk(acc, scale, origin, items, texts, elsewhere, depth=0):
    if depth > 24 or len(items) >= 260:
        return
    try:
        role_name = (acc.get_role_name() or "").lower()
        name = acc.get_name() or ""
        rect = acc.get_extents(Atspi.CoordType.SCREEN)
        x, y, w, h = rect.x, rect.y, rect.width, rect.height
        showing = False
        try:
            showing = acc.get_state_set().contains(Atspi.StateType.SHOWING)
        except Exception:
            showing = True
        role = ROLE_WORDS.get(role_name)
        value = ""
        if role in ("text field", "text", "cell"):
            value = acc_text(acc)
        if role:
            label = name or value
            item = {
                "role": role,
                "label": label[:80],
                "bounds": [round(x / scale), round(y / scale), round(w / scale), round(h / scale)],
            }
            if value and role == "text field":
                item["value"] = value[:80]
            try:
                if acc.get_state_set().contains(Atspi.StateType.SELECTED) or acc.get_state_set().contains(Atspi.StateType.FOCUSED):
                    item["focused"] = True
            except Exception:
                pass
            if not showing:
                item["offscreen"] = True
            if w > 0 and h > 0:
                items.append(item)
            if label:
                if showing:
                    if sum(len(t) for t in texts) < 5000:
                        texts.append(label)
                elif sum(len(t) for t in elsewhere) < 4000:
                    elsewhere.append(label)
        if value and value not in texts and showing:
            texts.append(value[:200])
        for i in range(acc.get_child_count()):
            walk(acc.get_child_at_index(i), scale, origin, items, texts, elsewhere, depth + 1)
    except Exception:
        return


def atspi_ui(win):
    if Atspi is None:
        return None
    app = atspi_app(win.get("pid", 0), (win.get("app") or "").lower())
    if app is None:
        return None
    scale = scale_for(win["bounds"])
    items, texts, elsewhere = [], [], []
    walk(app, scale, win["bounds"][:2], items, texts, elsewhere)
    return {
        "controls": items,
        "texts": texts[:400],
        "elsewhere": elsewhere[:200],
    }


# ---------------------------------------------------------------- OCR


def temp_png():
    """A new .png file only this user can read, for grim or convert to write over. mkstemp makes it, so no other
    program can take the name between choosing it and writing it (mktemp's race)."""
    fd, path = tempfile.mkstemp(suffix=".png")
    os.close(fd)
    return path


def drop(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def wrote(r, path):
    """The command succeeded and left a picture (an empty file is what mkstemp made)."""
    return r.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0


def capture_png(win=None, screen=False, cursor=False):
    tmp = temp_png()
    cmd = ["grim"]
    if cursor:
        cmd.append("-c")
    if not screen and win:
        x, y, w, h = win["bounds"]
        cmd += ["-g", f"{x},{y} {w}x{h}"]
    r = sh(cmd + [tmp])
    if not wrote(r, tmp):
        drop(tmp)
        return None
    return tmp


def tsv_words(png, origin, scale):
    r = sh(["tesseract", png, "stdout", "--psm", "6", "tsv"])
    if r.returncode != 0:
        return []
    words = []
    for line in r.stdout.splitlines():
        cols = line.split("\t")
        if len(cols) < 12 or cols[0] != "5":
            continue
        try:
            left, top, w, h = (int(cols[6]), int(cols[7]), int(cols[8]), int(cols[9]))
        except Exception:
            continue
        text = cols[11].strip()
        if not text:
            continue
        words.append(
            {
                "text": text,
                "bounds": [
                    round(origin[0] + left / scale),
                    round(origin[1] + top / scale),
                    round(w / scale),
                    round(h / scale),
                ],
            }
        )
    return words


BROWSER = re.compile(r"zen|firefox|chrom|brave|mozilla|vivaldi", re.I)


def browser_sidebar(win):
    if not BROWSER.search((win.get("app") or "") + " " + (win.get("exe") or "")):
        return []
    x, y, w, h = win["bounds"]
    sw = min(380, w)
    tmp = temp_png()
    r = sh(["grim", "-g", f"{x},{y} {sw}x{h}", tmp])
    if not wrote(r, tmp):
        drop(tmp)
        return []
    big = temp_png()
    try:
        sh(["convert", tmp, "-resize", "200%", big])
        scale = scale_for(win["bounds"]) * 2
        words = tsv_words(big, (x, y), scale)
        lines, cur, last_y = [], [], None
        for wd in words:
            if last_y is not None and abs(wd["bounds"][1] - last_y) > 10:
                lines.append(cur)
                cur = []
            cur.append(wd)
            last_y = wd["bounds"][1]
        if cur:
            lines.append(cur)
        return [" ".join(wd["text"] for wd in line) for line in lines if line]
    finally:
        for f in (tmp, big):
            try:
                os.unlink(f)
            except Exception:
                pass


def ocr_ui(win):
    png = capture_png(win)
    if not png:
        return {"controls": [], "texts": "", "elsewhere": ""}
    try:
        scale = scale_for(win["bounds"])
        words = tsv_words(png, win["bounds"][:2], scale)
        if len(words) < 4:
            # Dark themes and thin terminal fonts read better inverted; try once more.
            alt = temp_png()
            try:
                sh(["convert", png, "-colorspace", "Gray", "-negate", "-normalize", alt])
                more = tsv_words(alt, win["bounds"][:2], scale)
                if len(more) > len(words):
                    words = more
            except Exception:
                pass
            finally:
                try:
                    os.unlink(alt)
                except Exception:
                    pass
        lines, cur, last_y = [], [], None
        for w in words:
            if last_y is not None and abs(w["bounds"][1] - last_y) > 12:
                lines.append(cur)
                cur = []
            cur.append(w)
            last_y = w["bounds"][1]
        if cur:
            lines.append(cur)
        controls = []
        for line in lines:
            if not line:
                continue
            x0 = min(w["bounds"][0] for w in line)
            y0 = min(w["bounds"][1] for w in line)
            x1 = max(w["bounds"][0] + w["bounds"][2] for w in line)
            y1 = max(w["bounds"][1] + w["bounds"][3] for w in line)
            text = " ".join(w["text"] for w in line)
            controls.append({"role": "text", "label": text[:80], "bounds": [x0, y0, x1 - x0, y1 - y0]})
        texts = [c["label"] for c in controls][:400]
        sidebar = browser_sidebar(win)
        if sidebar:
            texts = ["Sidebar (top to bottom): " + " | ".join(sidebar)] + texts
        return {"controls": controls, "texts": texts, "elsewhere": []}
    finally:
        try:
            os.unlink(png)
        except Exception:
            pass


def ui_data(win, controls_only=False):
    a = atspi_ui(win)
    if not a or not a["controls"]:
        a = ocr_ui(win)
    controls = list(a.get("controls") or [])
    if is_zen(win):
        z = win.get("zen") or zen_state()
        if z:
            controls = zen_tab_controls(z, zen_active_title(win)) + controls
            a["controls"] = controls
            a["zen"] = z
    for i, c in enumerate(controls, 1):
        c["id"] = i
    if controls_only:
        return controls
    return a


