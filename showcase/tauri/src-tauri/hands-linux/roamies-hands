def cmd_selftest_drag():
    """Prove a left drag and a right-drag pan on shapez, with before/after pictures and a pixel-change count."""
    w = None
    for c in visible_clients():
        if "shapez" in ((c.get("class") or "") + " " + (c.get("title") or "")).lower():
            w = win_info(c)
            break
    if not w:
        fail("shapez isn't open. Start it, then run the self-test again.")
    if not focus_window(w):
        fail("Couldn't focus shapez.")
    time.sleep(0.6)
    bx, by, bw, bh = w["bounds"]
    # A horizontal belt run near the middle of the grid, and a camera pan to the right.
    a = [bx + int(bw * 0.12), by + int(bh * 0.42)]
    b = [a[0] + int(min(320, bw * 0.22)), a[1]]
    before = capture_png(w)
    if not before:
        fail("Couldn't capture shapez.")
    # The first hotbar slot is the belt in shapez.
    press_combo("1")
    time.sleep(0.25)
    left = pointer_drag(a, b, 1, 24, 0.012)
    time.sleep(0.5)
    after = capture_png(w)
    right_from = [bx + int(bw * 0.55), by + int(bh * 0.55)]
    right_to = [right_from[0] + 160, right_from[1]]
    right = pointer_drag(right_from, right_to, 2, 18, 0.012)
    time.sleep(0.5)
    pan = capture_png(w)
    def changed(x, y):
        if not (x and y):
            return None
        r = sh(["compare", "-metric", "AE", x, y, "null:"])
        text = (r.stderr or r.stdout).strip().split()[0]
        try:
            return int(round(float(text)))
        except Exception:
            return None
    d1 = changed(before, after)
    d2 = changed(after, pan)
    files = {"before": before, "after_left": after, "after_pan": pan}
    notes = []
    if d1 == 0:
        notes.append("the left drag changed no pixels")
    if d2 == 0:
        notes.append("the right drag changed no pixels")
    out({"ok": True, "window": w, "left": left, "right": right, "changed": {"left": d1, "pan": d2}, "files": files, "note": "; ".join(notes) or "left drag and right-drag pan both changed the screen"})


