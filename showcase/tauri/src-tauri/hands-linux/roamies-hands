# ---------------------------------------------------------------- uinput pointer
# A real virtual mouse for drags. A button held on one device and the pointer moved by another (or by a
# compositor dispatch) isn't one continuous gesture to a game: apps that track motion while a button is held
# (shapez belts, camera drags) need press, motion and release from the same uinput device.
EV_SYN, EV_KEY, EV_REL = 0, 1, 2
REL_X, REL_Y = 0, 1
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_RELBIT = 0x40045564, 0x40045565, 0x40045566
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502


class UinputMouse:
    """A virtual relative mouse (EV_REL plus the three buttons), created for one gesture and destroyed after."""

    def __init__(self, name="Roamies virtual mouse"):
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_REL)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_SYN)
        for key in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, key)
        for rel in (REL_X, REL_Y):
            fcntl.ioctl(self.fd, UI_SET_RELBIT, rel)
        # Legacy uinput_user_dev: name[80], input_id (4 u16), ff_effects_max, then the abs tables (unused).
        dev = struct.pack("80sHHHHI", name.encode()[:79], 0x06, 0x2333, 0x6667, 1, 0) + b"\0" * 1024
        os.write(self.fd, dev)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        time.sleep(0.06)

    def emit(self, kind, code, value):
        now = time.time()
        sec, usec = int(now), int((now - int(now)) * 1_000_000)
        os.write(self.fd, struct.pack("llHHi", sec, usec, kind, code, value))

    def syn(self):
        self.emit(EV_SYN, 0, 0)

    def move(self, dx, dy):
        if dx:
            self.emit(EV_REL, REL_X, int(dx))
        if dy:
            self.emit(EV_REL, REL_Y, int(dy))
        self.syn()

    def button(self, button, down):
        self.emit(EV_KEY, button, 1 if down else 0)
        self.syn()

    def close(self):
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except Exception:
            pass
        try:
            os.close(self.fd)
        except Exception:
            pass


def button_code(button):
    return {1: BTN_LEFT, 2: BTN_RIGHT, 3: BTN_MIDDLE}.get(int(button or 1), BTN_LEFT)


def cursor_pos():
    text = sh_out(["hyprctl", "cursorpos"]).strip()
    m = re.match(r"\s*(-?\d+)\s*,\s*(-?\d+)", text)
    return (int(m.group(1)), int(m.group(2))) if m else None


def pointer_goto(mouse, x, y, tolerance=2):
    """Move by relative uinput steps, reading the pointer back so acceleration can't leave it short or past."""
    for _ in range(80):
        pos = cursor_pos()
        if not pos:
            return False
        dx, dy = x - pos[0], y - pos[1]
        if abs(dx) <= tolerance and abs(dy) <= tolerance:
            return True
        # Small steps: a large relative jump under acceleration overshoots and oscillates.
        mouse.move(max(-20, min(20, dx)), max(-20, min(20, dy)))
        time.sleep(0.02)
    return False


def pointer_drag(a, b, button=1, steps=24, delay=0.01):
    """Press at a, move through interpolated points to b, release. Returns the cursor path endpoints."""
    mouse = UinputMouse()
    try:
        if not pointer_goto(mouse, a[0], a[1]):
            return {"ok": False, "error": "Couldn't put the pointer at the start point."}
        before = cursor_pos() or (round(a[0]), round(a[1]))
        mouse.button(button_code(button), True)
        time.sleep(0.04)
        steps = max(2, min(int(steps or 24), 200))
        for i in range(1, steps + 1):
            x = a[0] + (b[0] - a[0]) * i / steps
            y = a[1] + (b[1] - a[1]) * i / steps
            mouse.move(round(x) - (before[0] if i == 1 else round(a[0] + (b[0] - a[0]) * (i - 1) / steps)),
                       round(y) - (before[1] if i == 1 else round(a[1] + (b[1] - a[1]) * (i - 1) / steps)))
            time.sleep(max(0.001, float(delay or 0.01)))
        # Land on the exact end point even if acceleration stretched the path.
        pointer_goto(mouse, b[0], b[1])
        time.sleep(0.04)
        mouse.button(button_code(button), False)
        after = cursor_pos()
        return {"ok": True, "from": list(before or a), "to": list(after or b), "button": int(button or 1), "steps": steps}
    finally:
        mouse.close()


