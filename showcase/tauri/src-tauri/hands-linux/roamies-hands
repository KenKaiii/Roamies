def cmd_act(plan_json):
    try:
        plan = json.loads(plan_json)
    except Exception:
        fail("bad plan")
    target = plan.get("window")
    w = None
    if target:
        w = resolve(f"window:{target}")
    elif plan.get("app"):
        w = resolve(f"app:{plan['app']}")
    else:
        c = front_client()
        w = win_info(c, c.get("pid")) if c else None
    if not w:
        fail(f"No matching window is open ({plan.get('app') or target or 'front'}).")
    if blocked := hands_off(w):
        fail(f"Blocked for safety: {blocked} holds a terminal or passwords, and I never type or click in it. Show the user where to click instead.")
    if not focus_window(w):
        fail(f"Couldn't focus {w.get('app')} — it may have closed, or another window took the keyboard. Ask the user to click its window once, then try again.")
    before_text = norm_text(ui_data(w))
    done = []
    last_clicked = None
    progress({"ev": "borrow"})
    for n, step in enumerate(plan.get("steps", []), 1):
        do = step.get("do", "")
        try:
            # A step may have switched apps (alt+tab): check the front window before acting in it.
            if do != "wait":
                current = front_client()
                if current and (blocked := hands_off(current)):
                    fail(f"Step {n}: Blocked for safety: {blocked} came to the front, and I never type or click in it.")
            if do in ("click_at", "hover"):
                x, y = step.get("x"), step.get("y")
                if x is None or y is None:
                    raise ValueError("no point")
                step_bounds([x - 4, y - 4, 8, 8], do)
                if do == "click_at":
                    if (spot := window_at(x, y)) and (blocked := hands_off(spot)):
                        fail(f"Step {n}: Blocked for safety: that spot is on {blocked}, and I never click in it.")
                    bx, by, bw, bh = w["bounds"]
                    if not (bx - 2 <= x <= bx + bw + 2 and by - 2 <= y <= by + bh + 2):
                        fail(f"Step {n}: {x},{y} is outside the {w.get('app')} window ({w['bounds']}).")
                    title_before = active_title(w)
                    click_at(x, y, int(step.get("button", 1)))
                    time.sleep(0.35)
                    title_after = active_title(w)
                    rel = step.get("rel")
                    at = f"{rel[0]},{rel[1]} in the window" if isinstance(rel, list) and len(rel) == 2 else "in the window"
                    if title_after and title_after != title_before:
                        done.append(f"clicked at {at}; the window is now titled \"{title_after[:80]}\"")
                    else:
                        done.append(f"clicked at {at}; the window title is unchanged, so read its text below")
                else:
                    cursor_move(x, y)
                    done.append("hovered")
            elif do in ("workspace", "zen_workspace"):
                z = zen_state()
                if not z:
                    raise ValueError("Zen's session store couldn't be read, so its workspaces aren't known.")
                name = step.get("name") or step.get("workspace") or step.get("text")
                space = zen_find_space(z, name)
                if not space:
                    names = ", ".join(sp["name"] for sp in z.get("spaces") or [])
                    raise ValueError(f"there's no Zen workspace called {name!r} (the workspaces are: {names})")
                if not zen_switch_space(z, w, space):
                    raise ValueError(f"couldn't switch Zen to the {space['name']} workspace")
                t = zen_active_title(w)
                u = copy_active_url(w)
                done.append(f"switched to the {space['name']} workspace (now showing \"{t or 'a tab'}\" — {u or 'no address'})")
            elif do == "open_tab":
                done.append(zen_open_tab(w, step.get("url") or step.get("text"), step.get("workspace") or step.get("space")))
            elif do == "close_tab":
                done.append(zen_close_tab(w, step.get("workspace") or step.get("space"), step.get("index") or step.get("num"), step.get("text") or step.get("title"), step.get("url")))
            elif do == "move_tab":
                done.append(zen_move_tab(w, step.get("workspace") or step.get("space"), step.get("to") or step.get("destination"), step.get("index") or step.get("num"), step.get("text") or step.get("title"), step.get("url")))
            elif do == "workspace_create":
                done.append(zen_workspace_create(w, step.get("name")))
            elif do == "workspace_rename":
                done.append(zen_workspace_rename(w, step.get("workspace") or step.get("current"), step.get("name")))
            elif do == "tab":
                done.append(zen_activate_tab(w, step.get("workspace") or step.get("space"), step.get("index") or step.get("num"), step.get("text") or step.get("title"), step.get("url")))
            elif do in ("click", "click_text", "choose"):
                text = step.get("text") or step.get("option")
                c = find_control(w, text=text, cid=step.get("id"))
                if c and c.get("role") == "tab":
                    # A browser tab lives in the window's chrome, where a pointer click lands but doesn't activate it:
                    # switch through the browser itself, then check the selected tab's title and address.
                    done.append(zen_activate_tab(w, c.get("workspace"), None, c.get("title"), c.get("url")))
                    continue
                if not c:
                    if text and is_zen(w):
                        if risky(text) and step.get("confirmed") is not True:
                            fail(f"Step {n}: Stopped before opening \"{text}\": it could delete, pay, send or sign out, and the user hasn't said yes to that.")
                        done.append(zen_activate_tab(w, None, None, text, None))
                        continue
                    raise ValueError(f"couldn't find {text or step.get('id')}")
                label = c.get("label") or text or ""
                if risky(label) and step.get("confirmed") is not True:
                    fail(f"Step {n}: Stopped before clicking \"{label}\": it could delete, pay, send or sign out, and the user hasn't said yes to that.")
                x, y = center(c["bounds"])
                step_bounds(c["bounds"], do)
                title_before = active_title(w)
                click_at(x, y)
                time.sleep(0.3)
                title_after = active_title(w)
                last_clicked = c
                label = c.get("label", "")[:40]
                done.append(f"clicked {label}" + (f" (the window is now titled \"{title_after[:60]}\")" if title_after and title_after != title_before else " (no title change; read the text below)"))
            elif do in ("fill", "type"):
                text = step.get("text", "")
                if do == "fill":
                    field = step.get("field")
                    c = find_control(w, text=field, field=True) if field else last_clicked
                    if c:
                        x, y = center(c["bounds"])
                        step_bounds(c["bounds"], "click")
                        click_at(x, y)
                        time.sleep(0.12)
                        last_clicked = c
                    press_combo("ctrl+a")
                    time.sleep(0.05)
                before_type = norm_text(ui_data(w))
                if not type_text(text, bool(w.get("xwayland"))):
                    raise ValueError("couldn't type")
                # Read it back: an exact match is proof; otherwise a second look catches a slow redraw.
                verified = changed = False
                for attempt in range(4):
                    time.sleep(0.3)
                    read = ui_data(w)
                    after_type = norm_text(read)
                    verified = bool(text) and " ".join(str(text).split()).lower() in after_type
                    changed = after_type != before_type
                    if verified or changed:
                        break
                    # A field can lose the race to take the click: click it again, clear it, retype once.
                    if do == "fill" and attempt == 1 and field:
                        c = find_control(w, text=field, field=True)
                        if c:
                            click_at(*center(c["bounds"]))
                            time.sleep(0.2)
                            press_combo("ctrl+a")
                            time.sleep(0.05)
                            type_text(text, bool(w.get("xwayland")))
                done.append(("filled" if do == "fill" else "typed") + (" (verified)" if verified else " (the window changed)" if changed else " (no visible change; check it)"))
            elif do == "key":
                key = step.get("combo") or step.get("key") or ""
                if not press_combo(key):
                    raise ValueError("unknown key")
                time.sleep(0.25)
                changed = norm_text(ui_data(w)) != before_text
                done.append(f"pressed {key}" + (" (the window changed)" if changed else ""))
            elif do == "scroll":
                amount = int(step.get("dy") or step.get("y") or step.get("amount") or 3)
                direction = step.get("direction")
                button = "4" if direction == "up" or (direction != "down" and amount > 0) else "5"
                for _ in range(min(abs(amount), 12)):
                    ydotool("click", button)
                    time.sleep(0.03)
                done.append("scrolled")
            elif do == "wait":
                time.sleep(min(float(step.get("ms") or step.get("seconds") or 0.3), 5))
                done.append("waited")
            elif do == "focus":
                c = find_control(w, text=step.get("text"), cid=step.get("id"))
                if c:
                    click_at(*center(c["bounds"]))
                done.append("focused")
            else:
                raise ValueError(f"unsupported step {do}")
        except SystemExit:
            raise
        except Exception as e:
            fail(f"Step {n}: {e}")
    data = ui_data(w)
    fresh = resolve(f"window:{w['id']}") or w
    out({"ok": True, "window": fresh, "done": done, "controls": data["controls"], "texts": data["texts"], "elsewhere": data["elsewhere"]})


