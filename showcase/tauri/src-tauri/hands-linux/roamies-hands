def win_info(c, front_pid=None):
    x, y = c.get("at", [0, 0])
    w, h = c.get("size", [0, 0])
    app = c.get("class") or c.get("initialClass") or ""
    info = {
        "id": c.get("address"),
        "app": app,
        "exe": exe_for(c.get("pid", 0)),
        "title": c.get("title") or "",
        "bounds": [x, y, w, h],
        "pid": c.get("pid", 0),
        "xwayland": bool(c.get("xwayland")),
    }
    ws = c.get("workspace") or {}
    info["workspace"] = ws.get("name") or str(ws.get("id"))
    info["workspaceId"] = ws.get("id")
    info["fullscreen"] = c.get("fullscreen", 0)
    info["floating"] = bool(c.get("floating"))
