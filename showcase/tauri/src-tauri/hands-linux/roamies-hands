        button = "4" if (p.get("direction") or "down") == "up" or amount > 0 and (p.get("direction") == "up") else "5"
        if p.get("direction") == "up":
            button = "4"
        for _ in range(min(abs(amount), 15)):
            ydotool("click", button)
            time.sleep(0.03)
        out({"ok": True, "done": "Scrolled"})
    fail(f"unknown window action {action}")


