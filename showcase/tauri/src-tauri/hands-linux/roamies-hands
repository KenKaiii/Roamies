def main():
    args = sys.argv[1:]
    if not args:
        fail("no command")
    cmd = args[0]
    if cmd in ("trusted", "guide", "screencheck"):
        out({"ok": True, "supported": True})
    if cmd == "windows":
        cmd_windows()
    if cmd == "front":
        cmd_front()
    if cmd == "locate":
        cmd_locate(args[1] if len(args) > 1 else "front")
    if cmd == "capture":
        cmd_capture(args[1], args[2], args[3] if len(args) > 3 else None, args[4] if len(args) > 4 else None, int(args[5]) if len(args) > 5 and args[5].isdigit() else 900)
    if cmd == "ui":
        cmd_ui(args[1] if len(args) > 1 else "front", len(args) > 2 and args[2] == "controls")
    if cmd == "locate-control":
        cmd_locate_control(args[1], args[2])
    if cmd == "find-text":
        cmd_find_text(args[1], args[2], len(args) > 3 and args[3] == "scroll")
    if cmd == "ocr-find":
        cmd_ocr_find(args[1], args[2], len(args) > 3 and args[3] == "all")
    if cmd == "refine":
        cmd_refine(args[1], args[2] if len(args) > 2 else None)
    if cmd == "act":
        cmd_act(args[1])
    if cmd == "tab":
        try:
            plan = json.loads(args[1])
        except Exception:
            fail("bad tab arguments")
        t = plan.get("window") or (("app:" + plan["app"]) if plan.get("app") else "front")
        w = resolve(t)
        if not w:
            fail(f"No matching window is open ({plan.get('app') or t}).")
        if blocked := hands_off(w):
            fail(f"Blocked for safety: {blocked} holds a terminal or passwords, and I never switch its tabs or type in it.")
        if not focus_window(w):
            fail(f"Couldn't focus {w.get('app')}.")
        out({"ok": True, "done": zen_activate_tab(w, plan.get("workspace"), plan.get("index"), plan.get("text"), plan.get("url")), "window": w})
    if cmd == "select":
        cmd_select(args[1])
    if cmd == "wm":
        cmd_wm(args[1])
    if cmd == "pointer":
        cmd_pointer(args[1])
    if cmd == "selftest-type":
        cmd_selftest_type()
    if cmd == "selftest-safety":
        cmd_selftest_safety()
    if cmd == "selftest-drag":
        cmd_selftest_drag()
    fail(f"unknown command {cmd}")


if __name__ == "__main__":
    main()
